durduruluyor=threading.Event()
kilit=threading.Lock()
bulunanlar=[]
toplam_istek=[0]

def _dur(s,f):
    durduruluyor.set()
    print(f"\n{PFX} {SA}[!]{R} Durduruldu — Bulunan: {B}{len(bulunanlar)}{R}")
    sys.exit(0)
signal.signal(signal.SIGINT,_dur)

def inf(k,v):   print(f"{PFX} {Y}[+]{R} {B}{k}{R}: {C}{v}{R}")
def err(m):     print(f"{PFX} {K}[!]{R} {K}{m}{R}")
def kaydet(f,t):
    try: open(f,"a",encoding="utf-8").write(t+"\n")
    except: pass

def kelime_oku(dosya):
    try:
        with open(dosya,"r",encoding="utf-8",errors="ignore") as f:
            s=[l.strip() for l in f if l.strip() and not l.startswith("#")]
        inf("Kelime Listesi",f"{dosya} ({B}{len(s)}{R} kelime)")
        return s
    except FileNotFoundError:
        err(f"Dosya bulunamadı: {dosya}"); sys.exit(1)

def durum_rengi(k):
    if 200<=k<300: return Y
    if 300<=k<400: return C
    if k in (401,403): return SA
    if 500<=k<600: return K
    return G

def baslangic(mod, url=None, alan=None, args=None, ekstra=None):
    print(f"\n{C}{'═'*56}{R}")
    if url:  inf("Url             ", url)
    if alan: inf("Alan Adı        ", alan)
    inf("Mod             ", mod)
    inf("Metod           ", "GET")
    inf("İş Parçacığı    ", str(args.threads))
    if ekstra:
        for k,v in ekstra.items(): inf(k,v)
    inf("Engellenen Kodlar", args.negative_status_codes or "404")
    inf("User-Agent      ", args.useragent)
    inf("Zaman Aşımı     ", f"{args.timeout}s")
    if args.output: inf("Çıktı Dosyası   ", args.output)
    print(f"{C}{'─'*56}{R}")
    print(f"{PFX} {G}Tarama başlıyor — dizin listeleme modunda{R}")
    print(f"{C}{'─'*56}{R}\n")

def dizin_isci(base,q,uzantilar,gecerli,engel,zaman,ses,cikti):
    while not durduruluyor.is_set():
        try: kelime=q.get_nowait()
        except queue.Empty: break
        denemeler=[kelime]+([f"{kelime}.{u.lstrip('.')}" for u in uzantilar] if uzantilar else [])
        for d in denemeler:
            if durduruluyor.is_set(): break
            url=urljoin(base.rstrip("/")+"/",d)
            try:
                r=ses.get(url,timeout=zaman,allow_redirects=True,verify=False)
                with kilit: toplam_istek[0]+=1
                if r.status_code in engel: continue
                if gecerli and r.status_code not in gecerli: continue
                rk=durum_rengi(r.status_code); boy=len(r.content)
                with kilit:
                    print(f"{PFX} {rk}[{r.status_code}]{R} {B}{url}{R} {G}(Boyut: {boy}){R}")
                    bulunanlar.append(url)
                    if cikti: kaydet(cikti,f"[{r.status_code}] {url} (Boyut: {boy})")
            except: pass
        q.task_done()

def dizin_modu(args):
    hedef=args.url
    if not hedef.startswith("http"): hedef="http://"+hedef
    kelimeler=kelime_oku(args.wordlist)
    uzantilar=[u.strip() for u in args.extensions.split(",")] if args.extensions else []
    gecerli=set(int(x) for x in args.status_codes.split(",")) if args.status_codes else set()
    engel=set(int(x) for x in args.negative_status_codes.split(",")) if args.negative_status_codes else {404}
    ses=requests.Session(); ses.headers["User-Agent"]=args.useragent
    if args.cookies:
        for c in args.cookies.split(";"):
            p=c.strip().split("=",1)
            if len(p)==2: ses.cookies.set(p[0].strip(),p[1].strip())
    if args.headers:
        for h in args.headers:
            p=h.split(":",1)
            if len(p)==2: ses.headers[p[0].strip()]=p[1].strip()
    if args.username and args.password: ses.auth=(args.username,args.password)
    ekstra={}
    if uzantilar: ekstra["Uzantılar       "]=", ".join(uzantilar)
    baslangic("Dizin / Dosya Tarama",url=hedef,args=args,ekstra=ekstra)
    t0=time.time(); q=queue.Queue()
    for k in kelimeler: q.put(k)
    isc=[threading.Thread(target=dizin_isci,args=(hedef,q,uzantilar,gecerli,engel,args.timeout,ses,args.output),daemon=True) for _ in range(min(args.threads,len(kelimeler)))]
    for t in isc: t.start()
    for t in isc: t.join()
    print(f"\n{C}{'═'*56}{R}")
    print(f"{PFX} {Y}[+]{R} Tamamlandı — Süre: {B}{time.time()-t0:.2f}s{R}")
    print(f"{PFX} {Y}[+]{R} Toplam İstek: {B}{toplam_istek[0]}{R}")
    print(f"{PFX} {Y}[+]{R} Bulunan     : {Y}{B}{len(bulunanlar)}{R}")
    print(f"{C}{'═'*56}{R}\n")

def dns_isci(alan,q,cikti,goster_ip):
    while not durduruluyor.is_set():
        try: alt=q.get_nowait()
        except queue.Empty: break
        hedef=f"{alt}.{alan}"
        try:
            ipler=socket.gethostbyname_ex(hedef)[2]
            with kilit:
                satir=f"{PFX} {Y}[+]{R} {B}{hedef}{R}"
                if goster_ip: satir+=f" {G}[{', '.join(ipler)}]{R}"
                print(satir); bulunanlar.append(hedef)
                if cikti: kaydet(cikti,hedef+(f" [{', '.join(ipler)}]" if goster_ip else ""))
        except: pass
        finally:
            with kilit: toplam_istek[0]+=1
            q.task_done()

def dns_modu(args):
    alan=args.domain.lstrip("*. "); kelimeler=kelime_oku(args.wordlist)
    baslangic("DNS Alt Alan Tarama",alan=alan,args=args)
    t0=time.time(); q=queue.Queue()
    for k in kelimeler: q.put(k)
    isc=[threading.Thread(target=dns_isci,args=(alan,q,args.output,args.show_ips),daemon=True) for _ in range(min(args.threads,len(kelimeler)))]
    for t in isc: t.start()
    for t in isc: t.join()
    print(f"\n{C}{'═'*56}{R}")
    print(f"{PFX} {Y}[+]{R} Tamamlandı — Süre: {B}{time.time()-t0:.2f}s{R}")
    print(f"{PFX} {Y}[+]{R} Toplam Deneme: {B}{toplam_istek[0]}{R}")
    print(f"{PFX} {Y}[+]{R} Bulunan      : {Y}{B}{len(bulunanlar)}{R}")
    print(f"{C}{'═'*56}{R}\n")

def vhost_isci(base,alan,q,gecerli,engel,zaman,ses,cikti):
    while not durduruluyor.is_set():
        try: kelime=q.get_nowait()
        except queue.Empty: break
        vhost=f"{kelime}.{alan}"
        try:
            r=ses.get(base,headers={"Host":vhost},timeout=zaman,allow_redirects=False,verify=False)
            with kilit: toplam_istek[0]+=1
            if r.status_code in engel: q.task_done(); continue
            if gecerli and r.status_code not in gecerli: q.task_done(); continue
            rk=durum_rengi(r.status_code); boy=len(r.content)
            with kilit:
                print(f"{PFX} {rk}[{r.status_code}]{R} {B}{vhost}{R} {G}(Boyut: {boy}){R}")
                bulunanlar.append(vhost)
                if cikti: kaydet(cikti,f"[{r.status_code}] {vhost} (Boyut: {boy})")
        except:
            with kilit: toplam_istek[0]+=1
        q.task_done()

def vhost_modu(args):
    hedef=args.url
    if not hedef.startswith("http"): hedef="http://"+hedef
    alan=args.domain; kelimeler=kelime_oku(args.wordlist)
    gecerli=set(int(x) for x in args.status_codes.split(",")) if args.status_codes else set()
    engel=set(int(x) for x in args.negative_status_codes.split(",")) if args.negative_status_codes else {404}
    ses=requests.Session(); ses.headers["User-Agent"]=args.useragent
    baslangic("Sanal Host Tarama",url=hedef,alan=alan,args=args)
    t0=time.time(); q=queue.Queue()
    for k in kelimeler: q.put(k)
    isc=[threading.Thread(target=vhost_isci,args=(hedef,alan,q,gecerli,engel,args.timeout,ses,args.output),daemon=True) for _ in range(min(args.threads,len(kelimeler)))]
    for t in isc: t.start()
    for t in isc: t.join()
    print(f"\n{C}{'═'*56}{R}")
    print(f"{PFX} {Y}[+]{R} Tamamlandı — Süre: {B}{time.time()-t0:.2f}s{R}")
    print(f"{PFX} {Y}[+]{R} Toplam İstek: {B}{toplam_istek[0]}{R}")
    print(f"{PFX} {Y}[+]{R} Bulunan     : {Y}{B}{len(bulunanlar)}{R}")
    print(f"{C}{'═'*56}{R}\n")

def ekle(p,url=False,domain=False):
    if url:    p.add_argument("-u","--url",    required=True,metavar="URL")
    if domain: p.add_argument("-d","--domain", required=True,metavar="ALAN")
    p.add_argument("-w","--wordlist",   required=True,metavar="DOSYA")
    p.add_argument("-t","--threads",    type=int,default=10,metavar="SAYI")
    p.add_argument("-o","--output",     default=None,metavar="DOSYA")
    p.add_argument("--timeout",         type=int,default=10,metavar="SN")
    p.add_argument("-s","--status-codes",          default=None,metavar="200,301")
    p.add_argument("-b","--negative-status-codes", default=None,metavar="404,403")
    p.add_argument("--useragent",default="root@slayer/1.0",metavar="UA")

def ana():
    print(BANNER)
    ap=argparse.ArgumentParser(prog="root@slayer",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=f"{K}{B}root@slayer{R} — Türkçe Dizin, DNS ve Sanal Host Tarama Aracı",
        epilog=f"\n{B}Modlar:{R}\n  dir    → Dizin/dosya tarama\n  dns    → DNS alt alan keşfi\n  vhost  → Sanal host keşfi\n  ipucu  → CTF/Pentest bypass komutları\n\n{B}Örnek:{R}\n  root@slayer dir -u http://HEDEF -w /usr/share/wordlists/dirb/common.txt\n  root@slayer ipucu\n")
    alt=ap.add_subparsers(dest="mod",metavar="MOD")
    dp=alt.add_parser("dir",help="Dizin/dosya kaba kuvvet taraması")
    ekle(dp,url=True)
    dp.add_argument("-x","--extensions",default=None,metavar="php,txt")
    dp.add_argument("-c","--cookies",   default=None,metavar="CEREZ=DEGER")
    dp.add_argument("-H","--headers",   action="append",default=[],metavar="Ad: Deger")
    dp.add_argument("-U","--username",  default=None,metavar="KULLANICI")
    dp.add_argument("-P","--password",  default=None,metavar="SIFRE")
    dnsp=alt.add_parser("dns",help="DNS alt alan keşfi")
    ekle(dnsp,domain=True)
    dnsp.add_argument("--show-ips",action="store_true",default=False)
    vp=alt.add_parser("vhost",help="Sanal host keşfi")
    ekle(vp,url=True,domain=True)
    alt.add_parser("ipucu",help="CTF/Pentest bypass komutlarını göster")
    if len(sys.argv)==1: ap.print_help(); sys.exit(0)
    args=ap.parse_args()
    if   args.mod=="dir":   dizin_modu(args)
    elif args.mod=="dns":   dns_modu(args)
    elif args.mod=="vhost": vhost_modu(args)
    elif args.mod=="ipucu": print(CTF)
    else: ap.print_help()

if __name__=="__main__":
    ana()
PYEOF

